generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  users     User[]
  bookPi    BookPiLedger[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  
  monetization MonetizationAccount?
}

model MonetizationAccount {
  userId                 String   @id
  user                   User     @relation(fields: [userId], references: [id])
  earnedBalanceCents     Int      @default(0)
  qualifiedUses          Int      @default(0)
  approvedContributions  Int      @default(0)
  trainingCompleted      Boolean  @default(false)
  identityVerified       Boolean  @default(false)
  paymentAccountVerified Boolean  @default(false)
  profileComplete        Boolean  @default(false)
  sanctioned             Boolean  @default(false)
  underFraudReview       Boolean  @default(false)
}

model BookPiLedger {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  index         Int      
  eventType     String
  amount        Int      // in cents
  idempotencyKey String  @unique
  hash          String
  previousHash  String
  createdAt     DateTime @default(now())
  
  @@unique([tenantId, index])
}
