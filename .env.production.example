# Isabella Villaseñor AI — production variable contract
# Fill these values only in Vercel/GitHub Environment secrets.
# Never commit real credentials.

NODE_ENV=production
ISABELLA_RUNTIME_MODE=production
PUBLIC_URL=https://<production-host>
ISABELLA_STORAGE_PROVIDER=neon
DATABASE_URL=
AUTH_JWT_SECRET=
ENCRYPTION_MASTER_KEY=
CROWN_POLICY_SIGNING_KEY=
AEGIS_AUDIT_SECRET=
BOOKPI_SIGNATURE_ALGORITHM=ECDSA-P384
BOOKPI_SIGNING_KEY=

# At least one provider is required. You may configure more for fallback.
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=

# Required by the current production environment catalog.
PROVISION_OWNER_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Distributed controls / observability.
REDIS_URL=
REDIS_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
CROWN_ENFORCEMENT_MODE=enforce
ALLOW_GUEST_CHAT=false
AUTH_DEV_SESSION_ENABLED=false
DURABLE_JSON_ALLOWED=false
SANDBOX_ENABLED=false
