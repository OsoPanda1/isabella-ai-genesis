# Runtime Mode & Networking
NODE_ENV=development
ISABELLA_RUNTIME_MODE=development
PUBLIC_URL=http://localhost:3000
VERCEL_URL=
VERCEL_GIT_COMMIT_SHA=
INTERNAL_ORIGIN=
VERCEL=false

# Trusted Proxy Contract: vercel | cloudflare | generic | blank (blank = fail-closed)
TRUSTED_PROXY_MODE=

# Database & Storage
DATABASE_URL=
DATABASE_DIRECT_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
ISABELLA_STORAGE_PROVIDER=postgres
DURABLE_JSON_ALLOWED=false

# Supabase Integration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_DATABASE_SUPABASE_JWT_SECRET=
SUPABASE_DATABASE_SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_SUPABASE_SERVICE_ROLE_KEY=

# Auth, OIDC & Sessions
AUTH_JWT_SECRET=
SESSION_SECRET=
AUTH_ISSUER=
AUTH_AUDIENCE=isabella
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=604800
OIDC_JWKS_URL=
JWKS_CACHE_TTL=3600
AUTH_DEV_SESSION_ENABLED=false
ALLOW_GUEST_CHAT=false
PROVISION_OWNER_TOKEN=

# Cryptography & Governance
ENCRYPTION_MASTER_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm
CROWN_CONSTITUTION_VERSION=v4.2.0-sovereign
CROWN_POLICY_SIGNING_KEY=
AEGIS_AUDIT_SECRET=
CROWN_ENFORCEMENT_MODE=enforce
BOOKPI_SIGNATURE_ALGORITHM=ECDSA-P384
BOOKPI_SIGNING_KEY=

# Rate Limiting & Caching (Redis / Upstash / KV)
REDIS_URL=
REDIS_TOKEN=
REDIS_PREFIX=isabella
KV_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_TOKEN=
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_INFERENCE_PER_MINUTE=40
RATE_LIMIT_VOICE_PER_MINUTE=20

# AI Models & Providers
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
LLM_DEFAULT_MODEL=google/gemini-3.8-flash
LLM_VOICE_MODEL=openai/gpt-4o-mini-tts
VOICE_API_URL=
LLM_UPSTREAM_TIMEOUT_MS=8500
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OPENAI_COMPATIBLE_LOCAL_ENABLED=false
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_MODEL=Qwen/Qwen3-8B
OPENAI_COMPATIBLE_API_KEY=
NATIVE_COMPREHENSION_ENABLED=false

# Media & Video (Mux)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_PLAYBACK_ID=
MUX_WEBHOOK_ID=
MUX_INTRO_ASSET_ID=
MUX_INTRO_FALLBACK_TYPE=static

# Billing & Commerce (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ISABELLA_PAYOUT_CIRCUIT_CERTIFIED=false

# Observability (OpenTelemetry)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=isabella-ai

# Quantum Emulation & Sandbox
QUP_ZNE_LEVEL=3
QUP_PEC_ENABLED=true
QUP_QEC_DECODER=tensor-network
QUP_STRICT_ISOLATION=true
SANDBOX_ENABLED=false

# API Keys & Request Limits
API_KEY_HASH_SECRET=
API_KEY_PREFIX=isa_live
API_KEY_DEFAULT_TTL=2592000
API_KEY_MAX_TTL=31536000
API_KEY_ROTATION_GRACE_SECONDS=300
API_KEY_RATE_LIMIT_DEFAULT=100
INPUT_MAX_BODY_BYTES=262144
INPUT_MAX_MESSAGES=200
INPUT_MAX_ATTACHMENT_BYTES=10485760
INPUT_MAX_TOOLS_PER_REQUEST=20

# Feature Flags, Redaction & Tests
ISABELLA_FEATURE_FLAGS=
REDACT_EXTRA_KEYS=
GENESIS_MAX_TEST_FILES=8
