# Local development defaults. Staging/production MUST override these explicitly.
NODE_ENV=development
ISABELLA_RUNTIME_MODE=development
ISABELLA_STORAGE_PROVIDER=memory
# Canonical durable database authority: use DATABASE_URL only in staging/production.
DATABASE_URL=
DATABASE_DIRECT_URL=
# Dedicated JWT signing secret. NEVER reuse a Supabase service-role or secret key here.
AUTH_JWT_SECRET=
AUTH_DEV_SESSION_ENABLED=false
ALLOW_GUEST_CHAT=false
DURABLE_JSON_ALLOWED=false
ISABELLA_FEATURE_FLAGS=
VOICE_API_URL=
AEGIS_ALLOW_QESEM=false
AEGIS_ALLOW_QUANTUM=false
AEGIS_ALLOW_SESSION=false
AEGIS_AUDIT_SECRET=
AEGIS_DRY_RUN=false
AEGIS_ENVIRONMENT=development
AEGIS_HASH_SECRET=
AEGIS_IBM_BACKEND=
AEGIS_IBM_CHANNEL=
AEGIS_IBM_INSTANCE=
AEGIS_MAX_CIRCUITS=8
AEGIS_MAX_EXECUTIONS=20
AEGIS_MAX_QUBITS=32
AEGIS_MAX_SHOTS=1024
AEGIS_ML_THRESHOLD=0.9
API_KEY_DEFAULT_TTL=2592000
API_KEY_HASH_SECRET=
API_KEY_MAX_TTL=31536000
API_KEY_PREFIX=isa_live
API_KEY_RATE_LIMIT_DEFAULT=100
API_KEY_ROTATION_GRACE_SECONDS=300
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_AUDIENCE=isabella
AUTH_ISSUER=
AUTH_REFRESH_TOKEN_TTL=604800
BOOKPI_SIGNATURE_ALGORITHM=ECDSA-P384
BOOKPI_SIGNING_KEY=
CROWN_CONSTITUTION_VERSION=v4.2.0-sovereign
CROWN_ENFORCEMENT_MODE=enforce
CROWN_POLICY_SIGNING_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_MASTER_KEY=
INPUT_MAX_ATTACHMENT_BYTES=10485760
INPUT_MAX_BODY_BYTES=262144
INPUT_MAX_MESSAGES=200
INPUT_MAX_TOOLS_PER_REQUEST=20
ISABELLA_PAYOUT_CIRCUIT_CERTIFIED=false
JWKS_CACHE_TTL=3600
LLM_DEFAULT_MODEL=google/gemini-3.8-flash
LLM_UPSTREAM_TIMEOUT_MS=8500
LLM_VOICE_MODEL=openai/gpt-4o-mini-tts
OIDC_JWKS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=isabella-ai
PROVISION_OWNER_TOKEN=
PUBLIC_URL=http://localhost:3000
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_INFERENCE_PER_MINUTE=40
RATE_LIMIT_VOICE_PER_MINUTE=20
REDACT_EXTRA_KEYS=
REDIS_PREFIX=isabella
REDIS_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
SUPABASE_DATABASE_SUPABASE_JWT_SECRET=
SUPABASE_DATABASE_SUPABASE_SECRET_KEY=
SUPABASE_DATABASE_SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
