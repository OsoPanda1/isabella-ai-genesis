# ---------------------------------------------------------------------------
# IDENTIDAD Y PROVISIONAMIENTO SOBERANO
# ---------------------------------------------------------------------------
# Habilita sesiones de desarrollo local SIN pasar por OAuth real.
# REQUERIMIENTOS: AUTH_DEV_SESSION_ENABLED=true Y NODE_ENV=development.
# Si falta cualquiera de las dos, la puerta queda cerrada (fail-closed).
# NUNCA activar en staging/production — el servidor rechazará 403.
# Uso: definir en .env.local para desarrollo local sin configurar OAuth.
AUTH_DEV_SESSION_ENABLED=
# Token de bootstrap para aprovisionar el primer tenant/owner (provision-owner).
# Requerido una sola vez; establezca un valor aleatorio largo y guárdelo.
PROVISION_OWNER_TOKEN=
# Secreto para HMAC de llaves de API (mín. 16 caracteres). Si se omite,
# el sistema deriva desde AUTH_JWT_SECRET.
API_KEY_HASH_SECRET=
AEGIS_HASH_SECRET=
AEGIS_AUDIT_SECRET=
API_KEY_PREFIX=
API_KEY_DEFAULT_TTL=
API_KEY_MAX_TTL=
API_KEY_ROTATION_GRACE_SECONDS=
API_KEY_RATE_LIMIT_DEFAULT=
# Clave opcional del modelo Gemini (si se usa como proveedor LLM).
GEMINI_API_KEY=
# Persistencia — fail-closed en producción. JSON solo para dev/test.
# En producción DEBE ser false y Supabase debe estar configurado, de lo contrario el arranque falla.
DURABLE_JSON_ALLOWED=
