# Isabella Villaseñor AI — .env.example
# ---------------------------------------------------------------------------
# Contrato de entorno (AGENTS.md §21):
#   * Toda clave validada por Zod en src/lib/env-schema.ts está documentada
#     aquí (lo exige test/unit/env-contract.test.ts).
#   * La ÚNICA vía de lectura en runtime es src/lib/config.ts; nada lee
#     process.env directo fuera de ella (mismamente verificado por test).
#   * Sin valores reales. Los secretos se configuran por entorno en Vercel
#     (Production/Preview/Development); aquí solo se documenta su existencia.
#   * Las claves SIN validación Zod que se conservan están marcadas como
#     "alias" o "plataforma": las inyecta Vercel o las consume config.ts como
#     alias de una canónica.
# ---------------------------------------------------------------------------

# ===== PLATAFORMA / RUNTIME =====
# inyectadas por Vercel en build/run; no requieren edición manual
VERCEL=
VERCEL_URL=
VERCEL_GIT_COMMIT_SHA=
NODE_ENV=development
ISABELLA_RUNTIME_MODE=
PUBLIC_URL=
APP_URL=
INTERNAL_ORIGIN=
# IP real del cliente tras el proxy: vercel | cloudflare | generic | vacío
TRUSTED_PROXY_MODE=
PORT=3000

# ===== AUTENTICACIÓN / SESIÓN =====
AUTH_JWT_SECRET=
AUTH_ISSUER=
AUTH_AUDIENCE=isabella
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=604800
OIDC_JWKS_URL=
JWKS_CACHE_TTL=3600
# Secreto dedicado para firmar la cookie de sesión del cliente (mín. 16 chars).
# Opcional: si se omite, la firma deriva de AUTH_JWT_SECRET. Recomendado en prod.
SESSION_SECRET=
# Desarrollo LOCAL únicamente (con NODE_ENV=development). NUNCA en
# staging/production: el servidor responde 403 si está activo (fail-closed).
AUTH_DEV_SESSION_ENABLED=false
# Chat sin identidad. Prohibido en staging/production (config.ts lo rechaza).
ALLOW_GUEST_CHAT=false
# Token de bootstrap para aprovisionar el primer tenant/owner (una sola vez).
PROVISION_OWNER_TOKEN=

# ===== BASE DE DATOS (autoridad única: DATABASE_URL) =====
DATABASE_URL=
# Directa (sin pool), reservada a migraciones.
DATABASE_DIRECT_URL=
# proveedor de persistencia: postgres | supabase | neon (auto: postgres si hay DATABASE_URL)
ISABELLA_STORAGE_PROVIDER=
# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Secreto JWT **Legacy** del proyecto Supabase (Dashboard → Settings → API →
# JWT Settings → "JWT Secret"/Legacy). P0-13: alimenta generateSupabaseRlsToken()
# (HS256) para que PostgREST valide los JWT y aplique aislamiento por RLS
# (tenant-scoped). OBLIGATORIA en producción; síncrono con el dashboard.
SUPABASE_JWT_SECRET=
# Service-role: SOLO provisionamiento aislado / bootstrap de esquema.
# Prohibido en el runtime de requests (P0-13; RLS es la vía de aislamiento).
SUPABASE_SERVICE_ROLE_KEY=
# Alias que la integración de Supabase en Vercel inyecta; config.ts los
# convierte a las canónicas de arriba.
SUPABASE_DATABASE_SUPABASE_URL=
SUPABASE_DATABASE_SUPABASE_ANON_KEY=
SUPABASE_DATABASE_SUPABASE_JWT_SECRET=
SUPABASE_DATABASE_POSTGRES_URL=
# Alias de Postgres inyectados por integraciones; nunca compiten con DATABASE_URL
# (config.ts falla si aparecen en staging/production junto a otro alias).
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
# Turso (libSQL)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ===== REDIS / KV (rate limiting y caché distribuida) =====
REDIS_URL=
REDIS_TOKEN=
REDIS_PREFIX=isabella
KV_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
UPSTASH_REDIS_TOKEN=

# ===== CIFRADO / API KEYS =====
ENCRYPTION_MASTER_KEY=
ENCRYPTION_ALGORITHM=aes-256-gcm
# HMAC dedicado de huella de llaves de API (mín. 16).
# P0-APIKEYS: OBLIGATORIO y SIN derivar de AUTH_JWT_SECRET (fail-closed).
API_KEY_HASH_SECRET=
# Prefijo de formato de credenciales Isabella: isk_<environment>_...
API_KEY_PREFIX=isk_live
API_KEY_DEFAULT_TTL=2592000
API_KEY_MAX_TTL=31536000
API_KEY_ROTATION_GRACE_SECONDS=300

# ===== CROWN / BOOKPI / IGDS =====
CROWN_CONSTITUTION_VERSION=v4.2.0-sovereign
CROWN_POLICY_SIGNING_KEY=
CROWN_ENFORCEMENT_MODE=enforce
# NOT_IMPLEMENTED | ECDSA_P256_SHA256 | ED25519 (ver BOOKPI_SIGNATURE_ALGORITHMS)
BOOKPI_SIGNATURE_ALGORITHM=
BOOKPI_SIGNING_KEY=
IGDS_SIGNING_KEY=
IGDS_KEY_ID=isabella-ed25519-2026-01
IGDS_TSA_URL=

# ===== AUDITORÍA AEGIS (latam-aegis-x) =====
# AEGIS_HASH_SECRET se deriva de API_KEY_HASH_SECRET al hacer spawn del
# pipeline (no se lee del entorno; fail-closed si falta).
AEGIS_HASH_SECRET=
AEGIS_AUDIT_SECRET=

# ===== PAGOS =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
X402_PAYMENT_VAULT_ADDRESS=
ISABELLA_PAYOUT_CIRCUIT_CERTIFIED=false

# ===== WEBHOOKS DE CONECTORES (firma verificada) =====
GITHUB_WEBHOOK_SECRET=
SLACK_SIGNING_SECRET=
LINEAR_WEBHOOK_SECRET=

# ===== IA / GATEWAY =====
GEMINI_API_KEY=
AI_GATEWAY_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
LLM_DEFAULT_MODEL=google/gemini-3.1-flash
LLM_VOICE_MODEL=openai/gpt-4o-mini-tts
LLM_UPSTREAM_TIMEOUT_MS=8500
# Federación gratuita: ópt-in explícito, solo endpoints HTTPS declarados.
FREE_AI_FEDERATION_ENABLED=false
FREE_AI_FEDERATION_ENDPOINTS=
# Ollama (local, opcional)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# OpenAI-compatible (endpoints propios/locales, opcional)
OPENAI_COMPATIBLE_LOCAL_ENABLED=false
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=

# ===== VOZ =====
VOICE_API_URL=
DEFAULT_RATE=0.92
DEFAULT_PITCH=-1
DEFAULT_VOLUME=0
MAX_TEXT_LENGTH=1000

# ===== LÍMITES DE ENTRADA / RATE LIMIT =====
INPUT_MAX_BODY_BYTES=262144
INPUT_MAX_MESSAGES=200
INPUT_MAX_ATTACHMENT_BYTES=10485760
INPUT_MAX_TOOLS_PER_REQUEST=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_INFERENCE_PER_MINUTE=40
RATE_LIMIT_VOICE_PER_MINUTE=20

# ===== PERSISTENCIA / FLAGS =====
# false en staging/production (config.ts lo exige); true solo dev/test.
DURABLE_JSON_ALLOWED=false
SANDBOX_ENABLED=false
FEATURE_LAB_MODE=false
ENABLE_MOCK_CHECKOUT=false
ISABELLA_FEATURE_FLAGS=
GENESIS_MAX_TEST_FILES=8
NATIVE_COMPREHENSION_ENABLED=false

# ===== TELEMETRÍA / EXPERIMENTACIÓN =====
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=isabella-ai
STATSIG_SERVER_API_KEY=
VITE_STATSIG_CLIENT_KEY=
VITE_PUBLIC_APP_URL=
REDACT_EXTRA_KEYS=

# ===== PUENTE CUÁNTICO / HSM =====
PYTHON_PATH=
QUANTUM_BRIDGE_PATH=scripts/quantum/isabella_quantum_bridge_v3.py
QUANTUM_BRIDGE_TIMEOUT_MS=8000
QUANTUM_BRIDGE_MAX_STDOUT_BYTES=4194304
QUANTUM_MAX_WIRES=32
QUANTUM_MAX_SHOTS=500000
HSM_TIMEOUT_MS=5000
API_TIMEOUT_SECONDS=60
# QUP (Quantum Utility Protocol)
QUP_ZNE_LEVEL=3
QUP_PEC_ENABLED=true
QUP_QEC_DECODER=tensor-network
QUP_STRICT_ISOLATION=true

# ===== MEDIA (Mux) =====
# Credenciales server-side opcionales para ingestión y gestión de assets.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_INTRO_ASSET_ID=
MUX_PLAYBACK_ID=
MUX_INTRO_FALLBACK_TYPE=procedural
