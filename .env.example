# ---------------------------------------------------------------------------
# IDENTIDAD Y PROVISIONAMIENTO SOBERANO
# ---------------------------------------------------------------------------
# Habilitar SOLO en desarrollo el flujo OAuth manual (código de un solo uso).
# Nunca en staging/production (fail-closed por defecto).
AUTH_DEV_SESSION_ENABLED=
# Token de bootstrap para aprovisionar el primer tenant/owner (provision-owner).
# Requerido una sola vez; establezca un valor aleatorio largo y ayúntele.
PROVISION_OWNER_TOKEN=
# Secreto para HMAC de llaves de API (mín. 16 caracteres). Si se omite,
# el sistema deriva desde AUTH_JWT_SECRET.
API_KEY_HASH_SECRET=
AEGIS_HASH_SECRET=
AEGIS_AUDIT_SECRET=
API_KEY_PREFIX=
API_KEY_DEFAULT_TTL=
API_KEY_MAX_TTL=
API_KEY_ROTATION_GRACE_SECONDS=
API_KEY_RATE_LIMIT_DEFAULT=
# Clave opcional del modelo Gemini (si se usa como proveedor LLM).
GEMINI_API_KEY=
