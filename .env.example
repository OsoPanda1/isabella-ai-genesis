# Auth & Security
AUTH_JWT_SECRET=
ISABELLA_AUTH_SECRET=
API_KEY_HASH_SECRET=
API_KEY_PEPPER=
# Isabella-owned credential format: isk_<environment>_<identifier>_<secret>
API_KEY_PREFIX=isk_live
API_KEY_DEFAULT_TTL=2592000
API_KEY_MAX_TTL=31536000
API_KEY_ROTATION_GRACE_SECONDS=300
ENCRYPTION_MASTER_KEY=
CROWN_POLICY_SIGNING_KEY=
ATLAS_EVENT_SIGNING_KEY=
AUTH_ACCESS_TOKEN_TTL=
AUTH_AUDIENCE=
AUTH_ISSUER=
AUTH_REFRESH_TOKEN_TTL=
# Secreto dedicado para firmar la cookie de sesión del cliente (mín. 16 chars).
# Opcional: si se omite, la firma deriva de AUTH_JWT_SECRET. Recomendado en prod.
SESSION_SECRET=
BOOKPI_SIGNATURE_ALGORITHM=
BOOKPI_SIGNING_KEY=
CROWN_CONSTITUTION_VERSION=
CROWN_ENFORCEMENT_MODE=
ENCRYPTION_ALGORITHM=
INPUT_MAX_ATTACHMENT_BYTES=
INPUT_MAX_BODY_BYTES=
INPUT_MAX_MESSAGES=
INPUT_MAX_TOOLS_PER_REQUEST=
ISABELLA_RUNTIME_MODE=
JWKS_CACHE_TTL=
LLM_DEFAULT_MODEL=
LLM_UPSTREAM_TIMEOUT_MS=
LLM_VOICE_MODEL=
OIDC_JWKS_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=
PUBLIC_URL=
RATE_LIMIT_DEFAULT_PER_MINUTE=
RATE_LIMIT_INFERENCE_PER_MINUTE=
RATE_LIMIT_VOICE_PER_MINUTE=
REDACT_EXTRA_KEYS=
REDIS_PREFIX=
# Secreto JWT **Legacy** del proyecto Supabase (Dashboard → Settings → API →
# JWT Settings → "JWT Secret"/Legacy). P0-13: alimenta generateSupabaseRlsToken()
# (HS256) para que PostgREST valide los JWT y aplique aislamiento por RLS
# (tenant-scoped). OBLIGATORIA en producción; síncrono con el dashboard.
# OPCIONAL / LEGACY — Solo se conserva para tareas de provisionamiento aisladas o
# bootstrap de esquema vía script de administración. NO se usa en el runtime de
# request de Isabella (P0-13: la persistencia es tenant-scoped con JWT del usuario,
# fail-closed sin identidad). No configurarlo en el entorno de producción.
# ---------------------------------------------------------------------------
# IDENTIDAD Y PROVISIONAMIENTO SOBERANO
# Habilita sesiones de desarrollo local SIN pasar por OAuth real.
# REQUERIMIENTOS: AUTH_DEV_SESSION_ENABLED=true Y NODE_ENV=development.
# Si falta cualquiera de las dos, la puerta queda cerrada (fail-closed).
# NUNCA activar en staging/production — el servidor rechazará 403.
# Uso: definir en .env.local para desarrollo local sin configurar OAuth.
AUTH_DEV_SESSION_ENABLED=
# Token de bootstrap para aprovisionar el primer tenant/owner (provision-owner).
# Requerido una sola vez; establezca un valor aleatorio largo y guárdelo.
PROVISION_OWNER_TOKEN=
# Secreto dedicado para el HMAC de llaves de API (mín. 16 caracteres).
# P0-APIKEYS: OBLIGATORIO y SIN derivar de AUTH_JWT_SECRET (fail-closed si falta).
# Secrets del pipeline de auditoría AEGIS (latam-aegis-x). Se resuelven desde
# API_KEY_HASH_SECRET y CROWN_POLICY_SIGNING_KEY respectivamente (fail-closed).
AEGIS_HASH_SECRET=
AEGIS_AUDIT_SECRET=
ISABELLA_NATIVE_API_KEY_SOVEREIGN=
ISABELLA_NATIVE_API_KEY_SOVEREIGN_HASH=
ISABELLA_NATIVE_API_KEY_SYSTEM=
ISABELLA_NATIVE_API_KEY_SYSTEM_HASH=
ALLOW_GUEST_CHAT=false
LEGACY_JWT_SECRET=
ENCRYPTION_ISABELLA_MASTER_KEY=

# IGDS — Genesis Document Seal (src/lib/igds/)
IGDS_SIGNING_KEY=
IGDS_KEY_ID=isabella-ed25519-2026-01
IGDS_TSA_URL=

# Official runtime variables (single canonical names; configure once per Vercel environment)
VOICE_API_URL=
LLM_DEFAULT_MODEL=google/gemini-3.1-flash
GEMINI_API_KEY=
VITE_PUBLIC_APP_URL=
VITE_STATSIG_CLIENT_KEY=
STATSIG_SERVER_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=

# App URLs
APP_URL=
PUBLIC_URL=
