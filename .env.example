# ===========================================================================
# ISABELLA VILLASEÑOR AI — CONFIGURATION CONTRACT
# ===========================================================================
# Este archivo documenta TODAS las variables de entorno que el sistema lee.
# Nunca copies secretos reales aquí. Los valores se cargan y validan en
# runtime por src/lib/config.ts (Zod). El arranque falla si una variable
# obligatoria no está definida.
# ---------------------------------------------------------------------------
# MODOS DE EJECUCION (src/lib/runtime-mode.ts)
#   development | staging | production | emergency | maintenance
# ---------------------------------------------------------------------------

# --- ENVIRONMENT -----------------------------------------------------------
# Entorno actual. Determina las exigencias de variables y el runtime-mode.
NODE_ENV=development
ISABELLA_RUNTIME_MODE=development
# PUBLIC_URL: URL canónica de despliegue (usada para CORS, OIDC issuer, openid)
PUBLIC_URL=http://localhost:3000

# --- SUPABASE (PostgreSQL única autoridad de datos) ------------------------
# Autenticación nativa de Supabase (src/lib/supabase-auth.ts)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Clave de servicio SOLO del lado servidor (NUNCA expuesta al navegador).
# Requiere grants específicos; no debe usarse desde el cliente.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret que firma los tokens de sesión de Supabase (para verificación server-side)
SUPABASE_JWT_SECRET=

# --- JWT / OIDC (src/lib/jwt-verifier.ts, oidc.ts, jwks-cache.ts) ---------
# Secreto de firma de tokens internos de sesión (session-service.ts)
AUTH_JWT_SECRET=
# Emisor canónico de los tokens (iss claim)
AUTH_ISSUER=${PUBLIC_URL}
# Audiencia esperada (aud claim)
AUTH_AUDIENCE=isabella
# TTL de token de acceso (en segundos). Default 3600.
AUTH_ACCESS_TOKEN_TTL=3600
# TTL de refresh token (en segundos). Default 604800 (7 días).
AUTH_REFRESH_TOKEN_TTL=604800
# URL de JWKS para proveedores OIDC externos (si se usan terceros)
OIDC_JWKS_URL=
# Cache TTL de claves públicas JWKS (en segundos)
JWKS_CACHE_TTL=3600

# --- CRYPTOGRAPHY / KEY ROTATION (key-rotation.ts, keyring.ts) ------------
# Clave de cifrado en reposo (cifrado de secretos de herramientas, etc.)
ENCRYPTION_MASTER_KEY=
# Algoritmo de cifrado. Default 'aes-256-gcm'.
ENCRYPTION_ALGORITHM=aes-256-gcm

# --- C.R.O.W.N. (policy-engine, constitutional-gate) ----------------------
# Versión de la constitución activa. Default 'v4.2.0'.
CROWN_CONSTITUTION_VERSION=v4.2.0
# Firma de la constitución publicada (policy-signing.ts). Deja vacío en dev.
CROWN_POLICY_SIGNING_KEY=
# Modo de enforcement: 'enforce' | 'warn' | 'dry-run'
CROWN_ENFORCEMENT_MODE=enforce

# --- BOOKPI (ledger) --------------------------------------------------------
# Algorithm de firma del ledger. 'NOT_IMPLEMENTED' es el default hasta
# integrar una implementación PQC real. Nunca afirmar Dilithium sin backend.
BOOKPI_SIGNATURE_ALGORITHM=NOT_IMPLEMENTED
# Clave de firma de bloques del ledger (si se usa HMAC en ausencia de PQC)
BOOKPI_SIGNING_KEY=

# --- REDIS (cache / rate limit distribuido / colas) -----------------------
# Opcional. Si no se define, se usa fallback en memoria por nodo.
REDIS_URL=
REDIS_PREFIX=isabella

# --- RATE LIMITING (rate-limit) --------------------------------------------
# Límite por defecto de requests/min por identidad/ip
RATE_LIMIT_DEFAULT_PER_MINUTE=120
# Límite del endpoint de inferencia (/api/isabella)
RATE_LIMIT_INFERENCE_PER_MINUTE=40
# Límite del endpoint de voz (/api/isabella-voice)
RATE_LIMIT_VOICE_PER_MINUTE=20

# --- AI GATEWAY / LLM (provider-router, model-policy) ---------------------
# Clave del gateway de IA (Lovable AI Gateway)
LOVABLE_API_KEY=
# Clave alternativa de Google Gemini (SDK server-side)
GEMINI_API_KEY=
# Modelo por defecto para inferencia de texto
LLM_DEFAULT_MODEL=google/gemini-3.6-flash
# Modelo de voz
LLM_VOICE_MODEL=openai/gpt-4o-mini-tts
# Timeout máximo de inferencia en ms (circuit breaker). Default 8500.
LLM_UPSTREAM_TIMEOUT_MS=8500

# --- TELEMETRY / OBSERVABILITY ---------------------------------------------
# Endpoint OpenTelemetry (OTLP) si aplica. Opcional.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=isabella-ai

# --- ENCRYPTION / SECRET REDACTION (secret-redactor.ts) -------------------
# Coma-separada de secretos adicionales que se deben redactar de los logs
REDACT_EXTRA_KEYS=

# --- INPUT LIMITS (input-limits.ts) ----------------------------------------
# Límite máximo de bytes del body. Default 256 * 1024 (256KB).
INPUT_MAX_BODY_BYTES=262144
# Número máximo de mensajes por conversación. Default 200.
INPUT_MAX_MESSAGES=200
# Tamaño máximo por adjunto en bytes. Default 10MB.
INPUT_MAX_ATTACHMENT_BYTES=10485760
# Límite de herramientas ejecutables por request. Default 20.
INPUT_MAX_TOOLS_PER_REQUEST=20
