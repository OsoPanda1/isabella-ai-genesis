AEGIS_ENVIRONMENT=development
AEGIS_DRY_RUN=true

AEGIS_HASH_SECRET=replace-with-long-random-secret
AEGIS_AUDIT_SECRET=replace-with-another-long-random-secret

AEGIS_ML_THRESHOLD=0.82

AEGIS_ALLOW_QUANTUM=false
AEGIS_ALLOW_QESEM=false
AEGIS_ALLOW_SESSION=false

AEGIS_IBM_CHANNEL=ibm_quantum_platform
AEGIS_IBM_BACKEND=
AEGIS_IBM_INSTANCE=

AEGIS_MAX_SHOTS=2048
AEGIS_MAX_QUBITS=32
AEGIS_MAX_CIRCUITS=128
AEGIS_MAX_EXECUTIONS=1000000
